{
  "name": "fideweb",
  "version": "0.0.0",
  "author": "Fidel Elie",
  "description": "Repository holding personal website",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev\" \"pnpm content dev\"",
    "build": "next build",
    "start": "next start",
    "content": "pnpm node ./content/cli",
    "content:dev": "ts-node-dev -r tsconfig-paths/register --watch config.content.* ./content/cli dev",
    "auth:spotify": "pnpm node ./scripts/spotify-auth-code-flow.ts",
    "node": "ts-node -r tsconfig-paths/register",
    "types": "tsc"
  },
  "dependencies": {
    "@inquirer/prompts": "^5.0.1",
    "@mdx-js/loader": "^3.0.1",
    "@mdx-js/mdx": "^3.0.1",
    "@mdx-js/react": "^3.0.1",
    "@next/mdx": "^14.2.2",
    "@tanstack/react-query": "^5.31.0",
    "gray-matter": "^4.0.3",
    "next": "14.2.2",
    "next-connect": "^1.0.0",
    "next-mdx-remote": "^4.4.1",
    "picocolors": "^1.0.0",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.12",
    "@tanstack/react-query-devtools": "^5.31.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "chokidar": "^3.6.0",
    "commander": "^12.0.0",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "open": "8.4.2",
    "ora": "^5.4.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  }
}
